# ---- Build ----
ARG DOTNET_SDK_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION} AS build
WORKDIR /src

# copy only csproj(s) first to leverage layer caching
COPY ["api/HealthArchiveAPI/HealthArchiveAPI/HealthArchiveAPI.csproj", "HealthArchiveAPI/"]
RUN dotnet restore "HealthArchiveAPI/HealthArchiveAPI.csproj"

# copy everything and publish
COPY api/ .
WORKDIR /src/HealthArchiveAPI/HealthArchiveAPI
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# ---- Runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_SDK_VERSION} AS runtime
WORKDIR /app

# install curl for healthcheck (optional)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# create non-root user
RUN groupadd -r app 2>/dev/null || true && \
    useradd -r -g app app 2>/dev/null || true && \
    mkdir -p /app && chown app:app /app

COPY --from=build /app/publish /app
RUN chown -R app:app /app
USER app

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

# healthcheck: using GetDoctors endpoint as health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD curl -f http://localhost/api/Doctor/GetDoctors || exit 1

ENTRYPOINT ["dotnet", "HealthArchiveAPI.dll"]