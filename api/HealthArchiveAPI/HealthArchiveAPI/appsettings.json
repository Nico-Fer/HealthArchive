{
  // Base común a todos los ambientes. Los valores propios de cada uno viven en
  // appsettings.Development.json / appsettings.Production.json, y los secretos
  // en user-secrets (local) o variables de entorno (Railway). Nunca acá.

  "ConnectionStrings": {
    "DbContext": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "HealthArchive",
    "Audience": "HealthArchiveClient",
    "AccessTokenMinutes": "15"
  },

  // Cierre por inactividad: el refresh token vence si pasan estos minutos sin /Refresh
  // ni /KeepAlive. El front (VITE_SESSION_IDLE_MINUTES) tiene que usar el mismo valor.
  "Session": {
    "IdleTimeoutMinutes": "120"
  },

  "Cors": {
    "AllowedOrigins": ""
  },

  "Cookies": {
    "Secure": "true",
    "SameSite": "None"
  },

  "Registration": {
    "ConsultoryCode": ""
  },

  "RunMigrationsOnStartup": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
