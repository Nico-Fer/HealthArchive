{
  // Base común a todos los ambientes. Los valores propios de cada uno viven en
  // appsettings.Development.json / appsettings.Production.json, y los secretos
  // en user-secrets (local) o variables de entorno (Railway). Nunca acá.

  "ConnectionStrings": {
    "DbContext": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "HealthArchive",
    "Audience": "HealthArchiveClient",
    "AccessTokenMinutes": "15"
  },

  // Cierre por inactividad: el refresh token vence si pasan estos minutos sin /Refresh
  // ni /KeepAlive. El front (VITE_SESSION_IDLE_MINUTES) tiene que usar el mismo valor.
  "Session": {
    "IdleTimeoutMinutes": "120"
  },

  "Cors": {
    "AllowedOrigins": ""
  },

  "Cookies": {
    "Secure": "true",
    "SameSite": "None"
  },

  "Registration": {
    "ConsultoryCode": ""
  },

  "RunMigrationsOnStartup": false,

  // Recordatorios de turnos por WhatsApp (Cloud API de Meta, ver docs/deploy.md §8).
  // Apagado por defecto. El token NUNCA va acá: WhatsApp__AccessToken como env var o
  // user-secrets. BaseUrl solo se cambia para probar contra un mock local.
  "WhatsApp": {
    "Enabled": false,
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v23.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "TemplateLanguage": "es_AR",
    "PatientReminderTemplate": "recordatorio_turno",
    "DoctorAgendaTemplate": "agenda_diaria"
  },

  // Horas del consultorio, no del servidor (Railway corre en UTC).
  "Reminders": {
    "TimeZone": "America/Argentina/Buenos_Aires",
    "PatientHoursBefore": 24,
    "DoctorAgendaTime": "07:30",
    "QuietHoursStart": "21:00",
    "QuietHoursEnd": "08:00",
    "PollMinutes": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
