{
  // Ambiente local (ASPNETCORE_ENVIRONMENT=Development, ver launchSettings.json).
  // Faltan a propósito: ConnectionStrings:DbContext y Jwt:Key → van en user-secrets.
  //   dotnet user-secrets set "Jwt:Key" "<clave de 32+ bytes>" --project HealthArchiveAPI

  // Los dos puertos del front: `npm run dev` (3000) y `npm run preview` (4173).
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,https://localhost:3000,http://localhost:4173"
  },

  // Se mantienen igual que en prod para que el flujo de cookies se pruebe local
  // tal cual corre después: la API sirve por https y Chrome acepta Secure en localhost.
  "Cookies": {
    "Secure": "true",
    "SameSite": "None"
  },

  // Local se migra a mano con `dotnet ef database update`, no al arrancar.
  "RunMigrationsOnStartup": false,

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // El SQL que genera EF, útil para ver qué consulta se está haciendo.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
