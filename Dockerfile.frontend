# ---- Build stage ----
FROM node:18-alpine AS build
WORKDIR /app

# copy package files first for caching
COPY web-app/package*.json web-app/
WORKDIR /app/web-app
RUN npm ci --legacy-peer-deps

# copy rest and build
COPY web-app/ .
# Create React App outputs to 'build' directory
RUN npm run build

# ---- Production stage (nginx) ----
FROM nginx:stable-alpine AS production
# remove default content
RUN rm -rf /usr/share/nginx/html/*

# copy built static files from Create React App build directory
COPY --from=build /app/web-app/build /usr/share/nginx/html

# Create nginx configuration for SPA support
RUN echo 'server {' > /etc/nginx/conf.d/default.conf && \
    echo '    listen 80;' >> /etc/nginx/conf.d/default.conf && \
    echo '    location / {' >> /etc/nginx/conf.d/default.conf && \
    echo '        root /usr/share/nginx/html;' >> /etc/nginx/conf.d/default.conf && \
    echo '        index index.html index.htm;' >> /etc/nginx/conf.d/default.conf && \
    echo '        try_files $uri $uri/ /index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '    }' >> /etc/nginx/conf.d/default.conf && \
    echo '}' >> /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -q -O- http://localhost/ || exit 1
